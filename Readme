DB_NAME=temple_donation

# ── Gmail SMTP (for email OTP & confirmations) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_email@gmail.com

# ── MessageWall SMS (phone OTP) ──────────────────────
# Register at: https://www.messagewall.in/
MESSAGEWALL_API_KEY=your_key
MESSAGEWALL_SENDER_ID=JGNATH
MESSAGEWALL_TEMPLATE_ID=your_template_id
MESSAGEWALL_ROUTE=2
MESSAGEWALL_API_URL=http://text.messagewall.in/api/smsapi
MESSAGEWALL_SETUP_TEMPLATE_ID=your_setup_template_id

# ── WhatsApp (co3.live / pinbot.ai) ──────────────────
WA_API_KEY=your_wa_api_key
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_TEMPLATE_NAME=your_template_name
WA_API_BASE=https://partnersv1.pinbot.ai/v3
```

> **Gmail App Password** — Go to Google Account → Security → 2-Step Verification → App Passwords → Create for "Mail"

> ⚠️ Add `.env` to `.gitignore` — never commit secrets to Git

