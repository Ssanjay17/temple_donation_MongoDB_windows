# ── DATABASE ─────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=your_database_name

# ── SMTP (Gmail) ─────────────────────────────────
# Step 1: Enable 2-Factor Authentication on your Gmail account
# Step 2: Go to Google Account → Security → App Passwords
# Step 3: Create App Password for "Mail" → copy the 16-char password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_gmail@gmail.com

# ── MESSAGE WALL (SMS OTP for Phone Verification) ─────────────────
# Sign up at: https://www.messagewall.in/
# Step 1: Register & get your Account Key from the MessageWall dashboard
# Step 2: Create a DLT-registered Sender ID (6 chars, e.g. JGNATH)
# Step 3: Register your OTP SMS template on TRAI DLT portal → get Template ID
# Step 4: Note your Route number from the dashboard (usually 2 = Transactional)
# Step 5: Fill all values below
MESSAGEWALL_API_KEY=your_messagewall_api_key
MESSAGEWALL_SENDER_ID=your_sender_id
MESSAGEWALL_TEMPLATE_ID=your_template_id
MESSAGEWALL_ROUTE=2
# Correct MessageWall API endpoint
MESSAGEWALL_API_URL=http://text.messagewall.in/api/smsapi

# DLT Template for ADMIN SETUP SMS OTP (register this separately on DLT portal)
# Template text: "Dear Admin, Your administrator setup OTP is {#var#} valid for {#var#} Do not share. VECTRA"
MESSAGEWALL_SETUP_TEMPLATE_ID=your_setup_template_id


WA_API_KEY          = your_whatsapp_api_key
WA_PHONE_NUMBER_ID  = your_phone_number_id
WA_TEMPLATE_ID      = your_template_id
WA_TEMPLATE_NAME    = your_template_name
WA_API_BASE         = https://partnersv1.pinbot.ai/v3

# ── GEMINI AI ─────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# ↑ Current GA image-generation model (Oct 2025+).
# gemini-2.0-flash-exp-image-generation was retired — do NOT use it (404).
# gemini-3-flash-preview is text-only — do NOT use it (NO_IMAGE).
# Docs: https://ai.google.dev/gemini-api/docs/models/gemini-2.5-flash-image
